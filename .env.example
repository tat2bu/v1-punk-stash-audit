# RPC Sepolia
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# ou
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Clé privée du déployeur (sans le préfixe 0x)
PRIVATE_KEY=your_private_key_here

# Adresse du déployeur
DEPLOYER_ADDRESS=0xYourDeployerAddress

# Adresses des contrats sur Sepolia
WETH_ADDRESS=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
ERC721_TOKEN_ADDRESS=0xYourERC721TokenAddress
ERC721_WRAPPER_ADDRESS=0xYourERC721WrapperAddress
ERC721_TRANSFER_HELPER_ADDRESS=0xYourTransferHelperAddress
